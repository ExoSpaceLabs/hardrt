# CLion
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged with your project. For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#cmake-build-*

# Legacy local hardware qualification / profiling evidence.
.qualification/

# Hardware qualification evidence is generated from a frozen source SHA and
# must not mutate that qualified source tree. Development runs and locally
# retained release packages stay untracked; the selected release package is
# published as a GitHub Release artifact from the qualified vX.Y.Z tag.
validation/stm32/20*/
validation/stm32/releases/
validation/stm32/sync_benchmarks/

# Local workspace state and generated build trees. Kept outside Git so a
# frozen hardware qualification checkout remains clean without deleting data.
/.idea/
/.codex
/build/
/build-*/
/install/
/install-*/
/cmake-build-*/
/examples/hardrt_h755_*/build-cortex_m/
/examples/hardrt_h755_*/cmake-build-*/

# Older manually archived qualification ZIPs are retained locally. The
# timestamped run directories and packaged release evidence are also ignored.
/validation/stm32/*.zip

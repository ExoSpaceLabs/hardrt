# HardRT STM32H755 stable-periodic-delay validator (OpenOCD)
set confirm off
set pagination off
set print pretty on
set mem inaccessible-by-default off

target extended-remote :3333
monitor arm semihosting disable
monitor reset halt

break *hrt_error
commands
  silent
  set $error_code = (unsigned int)$r0
  printf "hrt_error=%u\n", $error_code
  printf "RESULT: FAIL (hrt_error=%u)\n", $error_code
  detach
  quit
end

break *periodic_validation_emit
commands
  silent
  set $base = (unsigned int)$r0
  set $pass = *(unsigned int*)($base + 0)
  set $error = *(unsigned int*)($base + 4)
  set $irq = *(unsigned int*)($base + 8)
  set $releases = *(unsigned int*)($base + 12)
  set $low = *(unsigned int*)($base + 16)
  set $phase = *(unsigned int*)($base + 20)
  set $expected = *(unsigned int*)($base + 24)
  set $observed = *(unsigned int*)($base + 28)
  set $miss_result = *(unsigned int*)($base + 32)
  set $miss_late = *(unsigned int*)($base + 36)
  set $exact_result = *(unsigned int*)($base + 40)
  set $exact_late = *(unsigned int*)($base + 44)
  set $tick = *(unsigned int*)($base + 48)

  printf "pass=%u error=%u irq_count=%u release_count=%u low_counter=%u\n", $pass,$error,$irq,$releases,$low
  printf "phase=%u expected_last=%u observed_last=%u final_tick=%u\n", $phase,$expected,$observed,$tick
  printf "miss_result=%u miss_lateness=%u exact_result=%u exact_lateness=%u\n", $miss_result,$miss_late,$exact_result,$exact_late
  if $pass == 1 && $error == 0 && $releases == 16 && $expected == $observed && $miss_result == 1 && $miss_late == 3 && $exact_result == 0 && $exact_late == 0
    printf "RESULT: PASS\n"
  else
    printf "RESULT: FAIL (error=%u)\n", $error
  end
  detach
  quit
end
continue

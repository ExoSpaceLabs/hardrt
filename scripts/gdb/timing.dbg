# HardRT isolated timing helper for STM32H755 (OpenOCD)
# The firmware exposes exactly one active result set per build.

set confirm off
set pagination off
set print pretty on
set mem inaccessible-by-default off

target extended-remote :3333
monitor arm semihosting disable
monitor reset halt

break hrt_error
commands
  silent
  printf "\n*** hrt_error hit ***\n"
  printf "g_error = "
  p/x (unsigned)g_error
  bt
end

break example_fail
commands
  silent
  printf "\n*** timing example failure ***\n"
  printf "g_example_error = %u\n", (unsigned)g_example_error
  bt
end

break timing_target_reached
commands
  silent
  printf "\n--- Timing target reached ---\n"

  set $hz = (unsigned int)SystemCoreClock
  set $case = (unsigned int)g_timing_case_id
  set $event_hz = (unsigned int)g_timing_event_hz
  set $target = (unsigned int)g_timing_target_samples

  printf "SystemCoreClock=%u Hz\n", $hz
  printf "event_hz=%u target_samples=%u\n", $event_hz, $target

  if $case == 1
    printf "case=event_to_task\n"
    printf "metric=TIM2 ISR software timestamp -> latency task continuation\n"
    printf "NOTE: this is a composite software ISR-to-task response measurement; it is NOT hardware event-to-ISR latency.\n"
    printf "HardRT timing profile=none (no kernel timing hooks in this image)\n"
  else
    if $case == 2
      printf "case=sem_isr_ready\n"
      printf "metric=hrt_sem_give_from_isr entry -> waiter marked READY\n"
      printf "HardRT timing profile=ipc (only IPC hook points enabled)\n"
    else
      printf "case=UNKNOWN (%u)\n", $case
    end
  end

  # hrt_timing_stats_t layout:
  #  +0  min   (u32)
  #  +4  max   (u32)
  #  +8  avg   (u32)
  # +12  count (u32)
  # +16  sum   (u64: low word +16, high word +20)
  set $base = (unsigned int)&g_timing_stats
  set $min  = *(unsigned int*)($base + 0)
  set $max  = *(unsigned int*)($base + 4)
  set $avg  = *(unsigned int*)($base + 8)
  set $cnt  = *(unsigned int*)($base + 12)
  set $sum  = ((unsigned long long)*(unsigned int*)($base + 16)) | (((unsigned long long)*(unsigned int*)($base + 20)) << 32)

  printf "\n[RESULT]\n"
  printf "count=%u\n", $cnt
  printf "min=%u cycles, avg=%u cycles (sum/count=%u), max=%u cycles\n", \
         $min, $avg, (unsigned int)($sum / ($cnt ? $cnt : 1)), $max
  printf "min=%u ns, avg=%u ns, max=%u ns\n", \
         (unsigned int)(($min * 1000000000ull) / $hz), \
         (unsigned int)(($avg * 1000000000ull) / $hz), \
         (unsigned int)(($max * 1000000000ull) / $hz)

  printf "\n[TIMER CFG]\n"
  printf "TIM2: PSC=%u ARR=%u\n", *(unsigned int*)&tim2_psc_dbg, *(unsigned int*)&tim2_arr_dbg

  detach
  quit
end

continue

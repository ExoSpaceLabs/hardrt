# HardRT isolated timing helper for STM32H755 (OpenOCD)
# The firmware passes one fixed-layout result record to timing_target_reached().

set confirm off
set pagination off
set print pretty on
set mem inaccessible-by-default off

target extended-remote :3333
monitor arm semihosting disable
monitor reset halt

break hrt_error
commands
  silent
  printf "\n*** hrt_error hit ***\n"
  bt
  detach
  quit
end

break *example_fail
commands
  silent
  printf "\n*** timing example failure ***\n"
  printf "g_example_error = %u\n", (unsigned)$r0
  bt
  detach
  quit
end

break *timing_target_reached
commands
  silent
  printf "\n--- Timing target reached ---\n"

  # hrt_timing_result_t is an explicit 13 x u32 qualification ABI:
  #  +0  case_id
  #  +4  event_hz
  #  +8  target_samples
  # +12  core_hz
  # +16  tim2_psc
  # +20  tim2_arr
  # +24  min_cycles
  # +28  avg_cycles
  # +32  max_cycles
  # +36  count
  # +40  sum_lo
  # +44  sum_hi
  # +48  error
  set $base = (unsigned int)$r0
  set $case = *(unsigned int*)($base + 0)
  set $event_hz = *(unsigned int*)($base + 4)
  set $target = *(unsigned int*)($base + 8)
  set $hz = *(unsigned int*)($base + 12)
  set $psc = *(unsigned int*)($base + 16)
  set $arr = *(unsigned int*)($base + 20)
  set $min = *(unsigned int*)($base + 24)
  set $avg = *(unsigned int*)($base + 28)
  set $max = *(unsigned int*)($base + 32)
  set $cnt = *(unsigned int*)($base + 36)
  set $sum = ((unsigned long long)*(unsigned int*)($base + 40)) | (((unsigned long long)*(unsigned int*)($base + 44)) << 32)
  set $error = *(unsigned int*)($base + 48)

  printf "SystemCoreClock=%u Hz\n", $hz
  printf "event_hz=%u target_samples=%u\n", $event_hz, $target

  if $case == 1
    printf "case=event_to_task\n"
    printf "metric=TIM2 ISR software timestamp -> latency task continuation\n"
    printf "NOTE: this is a composite software ISR-to-task response measurement; it is NOT hardware event-to-ISR latency.\n"
    printf "HardRT timing profile=none (no kernel timing hooks in this image)\n"
  else
    if $case == 2
      printf "case=sem_isr_ready\n"
      printf "metric=hrt_sem_give_from_isr entry -> waiter marked READY\n"
      printf "HardRT timing profile=ipc (only IPC hook points enabled)\n"
    else
      if $case == 3
        printf "case=ready_to_task\n"
        printf "metric=waiter marked READY -> latency task continuation\n"
        printf "NOTE: includes ISR tail, PendSV/scheduler selection, context restore, exception return, and blocked semaphore return; it is not a pure context-switch microbenchmark.\n"
        printf "HardRT timing profile=ipc (waiter-READY start marker only)\n"
      else
        if $case == 4
          printf "case=scheduler_decision\n"
          printf "metric=entry to hrt__schedule -> return from hrt__schedule for TIM2 ISR wake\n"
          printf "NOTE: diagnostic image uses GNU ld --wrap around hrt__schedule; production HardRT kernel code is unchanged.\n"
          printf "HardRT timing profile=none\n"
        else
          printf "case=UNKNOWN (%u)\n", $case
        end
      end
    end
  end

  printf "\n[RESULT]\n"
  printf "count=%u\n", $cnt
  printf "min=%u cycles, avg=%u cycles (sum/count=%u), max=%u cycles\n", \
         $min, $avg, (unsigned int)($sum / ($cnt ? $cnt : 1)), $max
  printf "min=%u ns, avg=%u ns, max=%u ns\n", \
         (unsigned int)(($min * 1000000000ull) / ($hz ? $hz : 1)), \
         (unsigned int)(($avg * 1000000000ull) / ($hz ? $hz : 1)), \
         (unsigned int)(($max * 1000000000ull) / ($hz ? $hz : 1))
  printf "error=%u\n", $error

  printf "\n[TIMER CFG]\n"
  printf "TIM2: PSC=%u ARR=%u\n", $psc, $arr

  if $error == 0
    printf "RESULT: PASS\n"
  else
    printf "RESULT: FAIL (error=%u)\n", $error
  end

  detach
  quit
end

continue
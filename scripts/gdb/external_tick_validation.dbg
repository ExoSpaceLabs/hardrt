# HardRT STM32H755 external-tick validator (OpenOCD)
set confirm off
set pagination off
set print pretty on
set mem inaccessible-by-default off

target extended-remote :3333
monitor arm semihosting disable
monitor reset halt

break *external_tick_validation_emit
commands
  silent
  set $base = (unsigned int)$r0
  set $pass = *(unsigned int*)($base + 0)
  set $error = *(unsigned int*)($base + 4)
  set $irq = *(unsigned int*)($base + 8)
  set $wake = *(unsigned int*)($base + 12)
  set $low = *(unsigned int*)($base + 16)
  set $min = *(unsigned int*)($base + 20)
  set $max = *(unsigned int*)($base + 24)
  set $ctrl = *(unsigned int*)($base + 28)
  set $tick = *(unsigned int*)($base + 32)
  set $ms = *(unsigned int*)($base + 36)

  printf "pass=%u error=%u irq_count=%u wake_count=%u low_counter=%u\n", $pass,$error,$irq,$wake,$low
  printf "delta_ticks min=%u max=%u systick_ctrl=0x%08x final_tick=%u final_ms=%u\n", $min,$max,$ctrl,$tick,$ms
  if $pass == 1 && $error == 0
    printf "RESULT: PASS\n"
  else
    printf "RESULT: FAIL (error=%u)\n", $error
  end
  detach
  quit
end
continue

# HardRT STM32H755 bounded transitive priority inheritance contract
set confirm off
set pagination off
set print pretty on
set mem inaccessible-by-default off

target extended-remote :3333
monitor arm semihosting disable
monitor reset halt

break *hrt_error
commands
  silent
  set $err = (unsigned int)$r0
  printf "hrt_error=%u\n", $err
  printf "RESULT: FAIL (hrt_error=%u)\n", $err
  detach
  quit
end

break *mutex_pi_validation_emit
commands
  silent
  set $p = (unsigned int)$r0
  set $pass = *(unsigned int*)($p + 0)
  set $error = *(unsigned int*)($p + 4)
  set $flags = *(unsigned int*)($p + 8)
  set $before = *(unsigned int*)($p + 12)
  set $total = *(unsigned int*)($p + 16)
  set $low = *(unsigned int*)($p + 20)
  set $mid = *(unsigned int*)($p + 24)
  set $high = *(unsigned int*)($p + 28)
  set $owner_a = *(unsigned int*)($p + 32)
  set $owner_b = *(unsigned int*)($p + 36)

  printf "pass=%u error=%u flags=0x%x\n", $pass,$error,$flags
  printf "competitor_before_handoff=%u competitor_total=%u\n", $before,$total
  printf "ids: low=%u middle=%u high=%u owners: A=%u B=%u\n", $low,$mid,$high,$owner_a,$owner_b

  if $pass == 1 && $error == 0 && $flags == 255 && $before == 0 && $total == 0 && $owner_a == 0xffffffff && $owner_b == 0xffffffff
    printf "RESULT: PASS\n"
  else
    printf "RESULT: FAIL (error=%u)\n", $error
  end
  detach
  quit
end
continue
